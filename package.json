{
  "name": "vswrite-desktop",
  "version": "0.1.0",
  "description": "vswrite — A WYSIWYG editor for Typst documents",
  "author": "René Jesser",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "build": "unset ELECTRON_RUN_AS_NODE && electron-vite build",
    "start": "unset ELECTRON_RUN_AS_NODE && electron-vite preview",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "build:mcp": "node esbuild.mcp.mjs",
    "mcp": "node dist/mcp/server.mjs"
  },
  "bin": {
    "vswrite-mcp": "./dist/mcp/server.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-table-cell": "^3.0.0",
    "@tiptap/extension-table-header": "^3.0.0",
    "@tiptap/extension-table-row": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/suggestion": "^3.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.0",
    "docx": "^9.6.1",
    "electron-store": "^10.0.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^5.5.207",
    "simple-git": "^3.33.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^41.0.4",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "svelte": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
