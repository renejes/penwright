{
  "name": "penwright",
  "version": "0.7.0",
  "description": "Penwright — A WYSIWYG editor for Typst documents",
  "author": "René Jesser",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "build": "unset ELECTRON_RUN_AS_NODE && electron-vite build",
    "start": "unset ELECTRON_RUN_AS_NODE && electron-vite preview",
    "package:mac": "npm run build && npm run build:mcp-binary:all && npm run fetch:packages && npm run fetch:fonts && npm run audit:packages && electron-builder --mac",
    "package:win": "npm run build && npm run build:mcp-binary:win && npm run fetch:packages && npm run fetch:fonts && npm run audit:packages && electron-builder --win",
    "package:linux": "npm run build && npm run fetch:packages && npm run fetch:fonts && npm run audit:packages && electron-builder --linux",
    "build:mcp": "node esbuild.mcp.mjs",
    "build:mcp-binary": "node scripts/build-mcp-binary.mjs",
    "build:mcp-binary:all": "node scripts/build-mcp-binary.mjs --all",
    "build:mcp-binary:win": "node scripts/build-mcp-binary.mjs --win",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "fetch:packages": "node scripts/fetch-typst-packages.mjs",
    "fetch:fonts": "node scripts/fetch-typst-fonts.mjs",
    "audit:packages": "node scripts/audit-bundled-deps.mjs",
    "mcp": "node dist/mcp/server.mjs"
  },
  "bin": {
    "penwright-mcp": "./dist/mcp/server.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@melloware/coloris": "^0.25.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@polar-sh/sdk": "^0.46.7",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-table-cell": "^3.0.0",
    "@tiptap/extension-table-header": "^3.0.0",
    "@tiptap/extension-table-row": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/suggestion": "^3.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.0",
    "docx": "^9.6.1",
    "dompurify": "^3.3.3",
    "electron-store": "^10.0.0",
    "marked": "^18.0.5",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^5.5.207",
    "simple-git": "^3.33.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/dompurify": "^3.0.5",
    "concurrently": "^9.0.0",
    "electron": "^41.0.4",
    "electron-builder": "^26.0.0",
    "electron-builder-notarize": "^1.5.2",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "svelte": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.penwright.app",
    "productName": "Penwright",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/mcp/**"
    ],
    "afterPack": "scripts/afterPack-sign-mcp.mjs",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "extraResources": [
      {
        "from": "documentation/penwright-logo.svg",
        "to": "logo.svg"
      },
      {
        "from": "resources/bin/",
        "to": "bin/",
        "filter": [
          "typst-*"
        ]
      },
      {
        "from": "resources/sample-project/",
        "to": "sample-project/"
      },
      {
        "from": "dist/mcp/bin/",
        "to": "mcp/bin/",
        "filter": [
          "penwright-mcp-*"
        ]
      },
      {
        "from": "resources/typst-packages/",
        "to": "typst-packages/",
        "filter": [
          "preview/**",
          "manifest.json",
          "bundle-licenses.json"
        ]
      },
      {
        "from": "resources/fonts/",
        "to": "fonts/",
        "filter": [
          "**/*.ttf",
          "**/*.otf",
          "**/OFL.txt",
          "manifest.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "identity": "Rene Jesser (3LAHNFWNT3)"
    },
    "win": {
      "icon": "build/icons/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
