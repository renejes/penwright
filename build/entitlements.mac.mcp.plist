<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements applied to the standalone vswrite MCP binary (Bun-compiled).
  Bun bundles JavaScriptCore and needs JIT-related relaxations under
  Apple's Hardened Runtime (required for Notarization).

   - allow-jit: JSC emits JIT'd machine code at runtime
   - allow-unsigned-executable-memory: some JIT paths need it
   - disable-library-validation: lets Bun map newly-written executable pages

  No network or filesystem entitlements: the MCP server only talks stdio
  and reads/writes files inside the user's project directory.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
