{
  "version": "1",
  "colors": {
    "primary": "#111111",
    "accent": "#525252",
    "text": "#171717",
    "background": "#ffffff",
    "muted": "#a3a3a3"
  },
  "fonts": {
    "body": "Inter",
    "heading": "Inter",
    "code": "IBM Plex Mono"
  },
  "scale": {
    "base": "12pt",
    "leading": "0.65em",
    "paragraphSpacing": "",
    "firstLineIndent": "1.1em"
  },
  "layout": {
    "paper": "a4",
    "orientation": "portrait",
    "margin": "3.4cm",
    "columns": 1,
    "pageNumbering": "1",
    "pageHeader": "#text(size: 0.74em, tracking: 0.18em, fill: style-colors.muted)[MAGAZINE] #h(1fr) #text(size: 0.74em, tracking: 0.18em, fill: style-colors.muted)[01]",
    "pageFooter": "",
    "pageFill": "",
    "bleed": "",
    "cropMarks": false,
    "facingPages": false,
    "binding": ""
  },
  "headings": {
    "h1": {
      "size": "27pt",
      "weight": "semibold",
      "color": "text",
      "marginTop": "0.2em"
    },
    "h2": {
      "size": "13pt",
      "weight": "bold",
      "color": "accent",
      "marginTop": "1.4em"
    },
    "h3": {
      "size": "12pt",
      "weight": "semibold",
      "color": "text",
      "marginTop": "1em"
    },
    "h4": {
      "size": "11pt",
      "weight": "semibold",
      "color": "text",
      "marginTop": "1em"
    },
    "h5": {
      "size": "11pt",
      "weight": "bold",
      "color": "text",
      "marginTop": "0.9em"
    },
    "h6": {
      "size": "10pt",
      "weight": "bold",
      "color": "muted",
      "marginTop": "0.8em"
    },
    "numbering": ""
  },
  "elements": {
    "blockquote": {
      "borderColor": "accent",
      "borderWidth": "3pt",
      "paddingLeft": "1em",
      "textColor": "text",
      "italic": true
    },
    "codeBlock": {
      "background": "luma(245)",
      "paddingX": "1em",
      "paddingY": "0.6em",
      "borderRadius": "4pt"
    },
    "figure": {
      "captionPosition": "bottom",
      "captionSize": "9pt",
      "captionColor": "muted",
      "captionAlign": "left",
      "captionSeparator": ": ",
      "creditSeparator": " — ",
      "creditLabel": "Photo: "
    },
    "table": {
      "headerBackground": "primary",
      "headerTextColor": "background",
      "alternateRowFill": false,
      "borderColor": "muted",
      "cellPadding": "6pt"
    }
  },
  "sections": [
    {
      "id": "feature",
      "name": "Feature",
      "colors": {
        "accent": "#171717"
      },
      "fonts": {
        "body": "Inter",
        "heading": "Inter"
      },
      "scaleBase": "",
      "scaleLeading": "0.72em",
      "columns": 1,
      "headings": {
        "h1": {
          "size": "34pt",
          "weight": "bold",
          "color": "accent",
          "marginTop": "0.2em"
        },
        "h2": {
          "size": "18pt",
          "weight": "semibold",
          "color": "primary"
        }
      }
    },
    {
      "id": "interview",
      "name": "Interview",
      "colors": {
        "accent": "#404040"
      },
      "fonts": {
        "body": "Inter",
        "heading": "Inter"
      },
      "scaleBase": "10pt",
      "scaleLeading": "",
      "columns": 2,
      "headings": {
        "h1": {
          "size": "24pt",
          "weight": "bold",
          "color": "accent"
        },
        "h2": {
          "size": "13pt",
          "weight": "bold",
          "color": "accent"
        }
      }
    },
    {
      "id": "essay",
      "name": "Essay",
      "colors": {
        "accent": "#525252"
      },
      "fonts": {
        "body": "Inter",
        "heading": "Inter"
      },
      "scaleBase": "",
      "scaleLeading": "0.85em",
      "columns": 1,
      "headings": {
        "h1": {
          "size": "26pt",
          "weight": "medium",
          "color": "text",
          "marginTop": "0.4em"
        },
        "h2": {
          "size": "15pt",
          "weight": "semibold",
          "color": "text"
        }
      }
    },
    {
      "id": "photo-essay",
      "name": "Photo Essay",
      "colors": {
        "accent": "#000000"
      },
      "fonts": {
        "body": "Inter",
        "heading": "Inter"
      },
      "scaleBase": "",
      "scaleLeading": "",
      "columns": 1,
      "headings": {
        "h1": {
          "size": "40pt",
          "weight": "bold",
          "color": "primary",
          "marginTop": "0.2em"
        },
        "h2": {
          "size": "14pt",
          "weight": "semibold",
          "color": "muted"
        }
      }
    },
    {
      "id": "department",
      "name": "Department",
      "colors": {
        "accent": "#737373"
      },
      "fonts": {
        "body": "Inter",
        "heading": "Inter"
      },
      "scaleBase": "9pt",
      "scaleLeading": "",
      "columns": 3,
      "headings": {
        "h1": {
          "size": "16pt",
          "weight": "bold",
          "color": "accent",
          "marginTop": "0.2em"
        },
        "h2": {
          "size": "11pt",
          "weight": "bold",
          "color": "accent"
        }
      }
    }
  ],
  "custom": {
    "preamble": "// Asymmetric type area: narrow gutter, wide outer margin (calm, editorial).\n#set page(margin: (left: 3.4cm, right: 5.2cm, top: 3cm, bottom: 3.2cm))\n#set par(justify: true)\n#set figure(numbering: none)\n#show heading: set text(hyphenate: false)\n// Quiet, uniform table of contents — every entry the same size.\n#show outline.entry: it => { set text(size: 10.5pt, fill: style-colors.text, weight: \"regular\"); it }\n#show link: it => text(fill: style-colors.accent, it)"
  }
}